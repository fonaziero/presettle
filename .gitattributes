# Normalize line endings: LF in the repo, so scripts work in Docker/Linux CI
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Official ISO 20022 schemas are kept byte-for-byte as published (checksums in their README)
backend/src/main/resources/iso20022/*.xsd -text
